    <string name="settings_nav_floating">플로팅</string>
    <string name="settings_nav_floating_desc">콘텐츠 위에 표시되고 탐색 중에는 숨겨지며, 가장자리에서 ◀를 누르면 다시 나타납니다</string>
    <string name="settings_nav_docked">고정</string>
    <string name="settings_nav_docked_desc">항상 화면에 표시되며 콘텐츠가 자리를 비켜 줍니다</string>
